{
  "name": "@agenid/api",
  "version": "0.1.0",
  "description": "AgenID Registry REST API — Fastify. Implements the v1.1.1 §13 endpoints over a storage-independent RegistryStore.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgenID-protocol/agenid.git",
    "directory": "packages/api"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "node --enable-source-maps dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agenid/core": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "fastify": "^5.12.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
