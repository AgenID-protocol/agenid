PORT=3001
HOST=0.0.0.0
# Bearer token for authority-only writes (POST /v1/authority/keys, POST /v1/agents/:id/assertions). Leave unset to disable those routes.
AGENID_AUTHORITY_TOKEN=

# Durable registry storage (Supabase). If either is unset, this server falls back to
# MemoryStore (in-process, resets on every restart) — fine for local dev, not durable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
