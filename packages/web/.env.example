# Public origin of this site; used to build absolute links in badge.js and metadata.
NEXT_PUBLIC_SITE_URL=https://www.agenid.com

# Durable registry storage (Supabase). If either is unset, the resolver falls back to
# an empty in-process store (every lookup resolves as "not registered" rather than
# erroring) — safe for local dev/build, not durable, never used unless both are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional DNS provider credentials — /api/dns/auto-add only.
#
# When unset (the current production state), /api/dns/detect reports
# recommended: "manual" and /api/dns/auto-add returns 502 "not configured".
# Everything else in the domain-control flow still works without them:
# /api/dns/detect still reports the provider it found, and /api/dns/verify
# still does a real TXT lookup. Auto-add is a convenience, never the proof.
#
# SCOPE LIMIT — read before setting these. A server-side API token can only
# write records for zones inside AgenID's OWN provider account. It cannot add a
# TXT record to an operator's domain that AgenID does not control, which is the
# actual onboarding case. For third-party domains the correct paths are Domain
# Connect (already detected first) or per-operator OAuth, not a shared token.
# Setting these only automates AgenID-owned domains.
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=
