# Public origin of this site; used to build absolute links in badge.js and metadata.
NEXT_PUBLIC_SITE_URL=https://www.agenid.com

# Durable registry storage (Supabase). If either is unset, the resolver falls back to
# an empty in-process store (every lookup resolves as "not registered" rather than
# erroring) — safe for local dev/build, not durable, never used unless both are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# There are deliberately NO DNS provider credentials here.
#
# AgenID does not hold write access to an operator's DNS zone. `/api/dns/auto-add`,
# which did, is deleted rather than left unconfigured — a credential-holding write
# path sitting unconfigured in the tree invites a future session to "finish" it.
# Domain control is proved by a TXT record the operator publishes themselves
# (`POST /api/verify-dns`) or authorizes at their own provider through Domain
# Connect (`POST /api/domain/status`). Neither needs a credential from us.
# ---------------------------------------------------------------------------
