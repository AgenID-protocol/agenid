# Public origin of this site; used to build absolute links in badge.js and metadata.
NEXT_PUBLIC_SITE_URL=https://www.agenid.com

# Durable registry storage (Supabase). If either is unset, the resolver falls back to
# an empty in-process store (every lookup resolves as "not registered" rather than
# erroring) — safe for local dev/build, not durable, never used unless both are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
